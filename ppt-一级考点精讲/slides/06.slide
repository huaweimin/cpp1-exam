<Slide style={{ width: 1280, height: 720, background: '#FAF7F2' }}>
  {/* A 区标题 */}
  <Box style={{ height: 120, padding: '28px 70px 0 70px' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>模块 1 · C/C++ 程序基础</Text>
    <Box style={{ width: 64, height: 6, background: '#F97316', borderRadius: 3, marginTop: 10 }} />
  </Box>
  {/* B 区：左窄栏 + 右内容 */}
  <Box style={{ height: 540, padding: '26px 70px 0 70px', flexDirection: 'row', gap: 34 }}>
    {/* 左窄栏 */}
    <Box style={{ width: 300, background: 'linear-gradient(160deg, #F97316 0%, #EC4899 100%)', borderRadius: 18, padding: '34px 30px', justifyContent: 'space-between' }}>
      <Box style={{ flexDirection: 'column', gap: 12 }}>
        <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#FFFFFF' }}>模块 1</Text>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: 'rgba(255,255,255,0.95)', lineHeight: 1.4 }}>程序的骨架<br />怎么搭</Text>
      </Box>
      <Text style={{ fontSize: 17, color: 'rgba(255,255,255,0.85)', lineHeight: 1.7 }}>开发常识是单选题的常客，main 函数和注释更是判断题的「钉子户」。</Text>
    </Box>
    {/* 右内容 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 18 }}>
      {/* 流程图 SVG */}
      <Box style={{ background: '#FFFFFF', borderRadius: 16, border: '1px solid #F1E9DF', padding: '18px 22px' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A1A1A', marginBottom: 8 }}>程序开发完整流程（单选高频）</Text>
        <svg width={640} height={88} viewBox='0 0 660 100'>
          <rect x='10' y='22' width='130' height='56' rx='12' fill='#F97316' />
          <text x='75' y='56' fontSize='19' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>写源代码</text>
          <path d='M 150 50 L 178 50' stroke='#64748B' strokeWidth='3' />
          <path d='M 172 42 L 184 50 L 172 58 Z' fill='#64748B' />
          <rect x='192' y='22' width='130' height='56' rx='12' fill='#FB923C' />
          <text x='257' y='56' fontSize='19' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>编译</text>
          <path d='M 332 50 L 360 50' stroke='#64748B' strokeWidth='3' />
          <path d='M 354 42 L 366 50 L 354 58 Z' fill='#64748B' />
          <rect x='374' y='22' width='130' height='56' rx='12' fill='#EC4899' />
          <text x='439' y='56' fontSize='19' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>链接</text>
          <path d='M 514 50 L 542 50' stroke='#64748B' strokeWidth='3' />
          <path d='M 536 42 L 548 50 L 536 58 Z' fill='#64748B' />
          <rect x='556' y='22' width='96' height='56' rx='12' fill='#1E293B' />
          <text x='604' y='56' fontSize='19' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>运行</text>
        </svg>
      </Box>
      {/* 2×2 要点 */}
      <Box style={{ flexDirection: 'row', gap: 16, flex: 1 }}>
        <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, border: '1px solid #F1E9DF', padding: '16px 20px', flexDirection: 'column', gap: 6 }}>
          <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#F97316' }}>main() 唯一入口</Text>
          <Text style={{ fontSize: 15.5, color: '#64748B', lineHeight: 1.55 }}>程序从 main 开始执行，有且仅有一个，写多个直接报错。</Text>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, border: '1px solid #F1E9DF', padding: '16px 20px', flexDirection: 'column', gap: 6 }}>
          <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#F97316' }}>头文件 #include</Text>
          <Text style={{ fontSize: 15.5, color: '#64748B', lineHeight: 1.55 }}>引入库功能：cin、cout 需要 iostream，数学函数需要 cmath。</Text>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, border: '1px solid #F1E9DF', padding: '16px 20px', flexDirection: 'column', gap: 6 }}>
          <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#F97316' }}>注释不参与运行</Text>
          <Text style={{ fontSize: 15.5, color: '#64748B', lineHeight: 1.55 }}>单行 //，多行 /* */，都是写给人看的说明文字。</Text>
        </Box>
        <Box style={{ flex: 1, background: 'rgba(236,72,153,0.10)', borderRadius: 14, border: '2px solid #EC4899', padding: '16px 20px', flexDirection: 'column', gap: 6 }}>
          <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#EC4899' }}>⚠ 易错：注释不能嵌套</Text>
          <Text style={{ fontSize: 15.5, color: '#64748B', lineHeight: 1.55 }}>/* /* 注释 */ */ 是错的！遇到第一个 */ 注释就结束了。</Text>
        </Box>
      </Box>
    </Box>
  </Box>
  {/* C 区页脚 */}
  <Box style={{ height: 60, padding: '0 70px 20px 70px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
      <Box style={{ width: 32, height: 32, background: '#F97316', borderRadius: 16, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 'bold' }}>{'{ }'}</Text>
      </Box>
      <Text style={{ fontSize: 14, color: '#64748B' }}>C++ 一级备考第一课</Text>
    </Box>
    <Text style={{ fontSize: 14, color: '#64748B' }}>06 / 15</Text>
  </Box>
</Slide>
